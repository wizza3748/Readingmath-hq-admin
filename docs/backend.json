
{
  "entities": {
    "Institution": {
      "title": "Institution",
      "description": "Represents an educational institution in the system.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the institution." },
        "ownerName": { "type": "string", "description": "Name of the owner." },
        "loginId": { "type": "string", "description": "Login ID for the institution's account." },
        "ownerContact": { "type": "string", "description": "Contact number of the owner." },
        "email": { "type": "string", "format": "email", "description": "Email address of the institution." },
        "branch1": { "type": "string", "description": "Primary branch." },
        "branch2": { "type": "string", "description": "Secondary branch." },
        "everydayKoreanName": { "type": "string", "description": "Name for the 'Everyday Korean' service." },
        "dokdoName": { "type": "string", "description": "Name for the 'Dokdo' service." },
        "address": {
          "type": "object",
          "properties": {
            "zipCode": { "type": "string" },
            "address": { "type": "string" },
            "addressDetail": { "type": "string" }
          }
        },
        "managerName": { "type": "string", "description": "Name of the manager." },
        "managerContact": { "type": "string", "description": "Contact number of the manager." },
        "attachmentUrl": { "type": "string", "description": "URL of the attachment file." },
        "lastContractDate": { "type": "string", "format": "date", "description": "Date of the last contract renewal." },
        "serviceStatus": { "type": "string", "enum": ["일시정지", "정상", "무료사용", "미납정지"] },
        "franchiseType": { "type": "string", "enum": ["가맹전", "스탠다드", "슬림", "학교"] },
        "serviceType": { "type": "string", "enum": ["수학+과학", "수학", "과학"] },
        "fees": {
          "type": "object",
          "properties": {
            "minFee": { "type": "number" },
            "perStudentFee": { "type": "number" },
            "perStudentFee1": { "type": "number" },
            "perStudentFee2": { "type": "number" }
          }
        },
        "memo": { "type": "string", "description": "Internal notes about the institution." },
        "franchiseFeeAmount": { "type": "number", "description": "The amount paid for the franchise fee." },
        "franchiseFeePaidAt": { "type": "string", "format": "date-time", "description": "Timestamp when the franchise fee was paid." },
        "trainingFeeAmount": { "type": "number", "description": "The amount paid for the training fee." },
        "trainingFeePaidAt": { "type": "string", "format": "date-time", "description": "Timestamp when the training fee was paid." },
        "serviceChangeReservation": {
          "type": "object",
          "description": "Scheduled service change for the institution.",
          "properties": {
            "effectiveDate": { "type": "string", "format": "date" },
            "serviceStatus": { "type": "string", "enum": ["일시정지", "정상", "무료사용", "미납정지"] },
            "franchiseType": { "type": "string", "enum": ["가맹전", "스탠다드", "슬림", "학교"] },
            "serviceType": { "type": "string", "enum": ["수학+과학", "수학", "과학"] }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ownerName", "loginId", "ownerContact", "branch1", "serviceStatus", "serviceType", "fees"]
    },
    "DiagnosticTest": {
      "title": "Diagnostic Test",
      "description": "Represents a diagnostic test for a specific semester.",
      "type": "object",
      "properties": {
        "id": { "type": "number", "description": "Unique identifier for the test." },
        "semesterName": { "type": "string", "description": "Name of the semester (e.g., '초등 3학년 1학기')." },
        "totalQuestions": { "type": "number", "description": "Total number of questions in the test." },
        "status": { "type": "string", "enum": ["검수전", "검수완료"], "description": "The review status of the test." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp when the test was created." }
      },
      "required": ["id", "semesterName", "totalQuestions", "status", "createdAt"]
    },
    "Question": {
      "title": "Question",
      "description": "Represents a single question within a diagnostic test.",
      "type": "object",
      "properties": {
        "questionNumber": { "type": "number", "description": "Sequential number of the question within the test." },
        "questionType": { "type": "string", "enum": ["유형", "서술형"], "description": "Type of the question." },
        "unit": { "type": "string", "description": "The educational unit this question belongs to." },
        "contentArea": { "type": "string", "description": "The specific content area of the question." },
        "difficulty": { "type": "string", "enum": ["상", "중", "하"], "description": "Difficulty level of the question." },
        "prompt": { "type": "string", "description": "The main text or prompt of the question." },
        "solutionCount": { "type": "number", "description": "Number of registered solutions for the question." },
        "isExtended": { "type": "boolean", "description": "Whether this is an extended question." },
        "isReviewed": { "type": "boolean", "description": "Whether the question has been reviewed." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["questionNumber", "questionType", "prompt", "isReviewed"]
    }
  },
  "auth": {
    "providers": []
  },
  "firestore": {
    "/institutions/{institutionId}": {
      "schema": { "$ref": "#/entities/Institution" },
      "description": "Stores information about each institution."
    },
    "/diagnostic-tests/{testId}": {
      "schema": { "$ref": "#/entities/DiagnosticTest" },
      "description": "Stores information about each diagnostic test."
    },
    "/diagnostic-tests/{testId}/questions/{questionId}": {
        "schema": { "$ref": "#/entities/Question" },
        "description": "Stores all questions for a specific diagnostic test."
    }
  }
}
