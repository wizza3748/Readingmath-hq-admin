
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /institutions/{document=**} {
      allow read, write: if true;
    }
    match /diagnostic-tests/{testId} {
      allow read, write: if true;
        match /questions/{questionId} {
          allow read, write: if true;
        }
    }
    match /curriculum-units/{unitId} {
      allow read, write: if true;
    }
  }
}

    